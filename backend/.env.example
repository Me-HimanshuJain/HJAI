# Copy this file to .env and fill in your values
# For Docker usage, these are set in docker-compose.yml

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hjai

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── ChromaDB ─────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# ─── Ollama (Local LLM) ───────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ─── Security ─────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_random_string_in_production
ENVIRONMENT=development

# ─── Email (Meeting Recap Bot) ────────────────────────
# For Gmail, use an App Password (not your main password)
# Generate at: myaccount.google.com → Security → App Passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
RECAP_EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# ─── Google Calendar (Meeting Bot) ────────────────────
# Download credentials.json from Google Cloud Console
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client
# Save the file as backend/credentials.json
